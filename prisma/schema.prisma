// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                String             @id
  name              String
  users             User[]
  drivers           Driver[]
  vehicles          Vehicle[]
  services          MobilityService[]
  providers         ProviderLocation[]
  expenses          Expense[]
  transactionEvents TransactionEvent[]
  notifications     Notification[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model User {
  id            String         @id
  authUserId    String?        @unique
  companyId     String
  name          String
  email         String         @unique
  role          String
  status        String         @default("active")
  company       Company        @relation(fields: [companyId], references: [id])
  driver        Driver?
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Driver {
  id            String   @id
  companyId     String
  userId        String?  @unique
  vehicleId     String?
  name          String
  email         String
  status        String
  costCenter    String
  monthlySpend  Decimal  @db.Decimal(12, 2)
  personalSpend Decimal  @db.Decimal(12, 2)
  currency      String   @default("EUR")
  company       Company  @relation(fields: [companyId], references: [id])
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, vehicleId])
}

model Vehicle {
  id           String   @id
  companyId    String
  plate        String
  make         String
  model        String
  fuelType     String
  status       String
  costCenter   String
  monthlySpend Decimal  @db.Decimal(12, 2)
  currency     String   @default("EUR")
  mileageKm    Int
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MobilityService {
  id               String   @id
  companyId        String
  type             String
  name             String
  description      String
  enabled          Boolean
  monthlyLimit     Decimal  @db.Decimal(12, 2)
  currency         String   @default("EUR")
  requiresApproval Boolean
  company          Company  @relation(fields: [companyId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, type])
}

model ProviderLocation {
  id         String   @id
  companyId  String
  name       String
  service    String
  address    String
  city       String
  distanceKm Float
  status     String
  company    Company  @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Expense {
  id              String             @id
  companyId       String
  date            String
  driverId        String
  vehicleId       String
  service         String
  provider        String
  amount          Decimal            @db.Decimal(12, 2)
  vat             Decimal            @db.Decimal(12, 2)
  currency        String             @default("EUR")
  status          String
  expenseType     String
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  rejectionReason String?
  receiptPath     String?
  receiptName     String?
  receiptMimeType String?
  receiptSize     Int?
  company         Company            @relation(fields: [companyId], references: [id])
  events          TransactionEvent[]
  notifications   Notification[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("FleetTransaction")
}

model TransactionEvent {
  id            String           @id
  companyId     String
  transactionId String
  type          String
  actorId       String
  actorName     String
  actorRole     String
  details       Json             @default("{}")
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expense       Expense          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())

  @@index([companyId, transactionId, createdAt])
}

model Notification {
  id            String            @id
  companyId     String
  userId        String
  transactionId String?
  type          String
  title         String
  message       String
  readAt        DateTime?
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense       Expense?          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@index([userId, readAt, createdAt])
  @@index([companyId, transactionId])
}
